---
// Main layout component that wraps all pages
// Provides consistent structure, navigation, and styling across the site
import ShaderBackground from '../components/ShaderBackground.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Sankalp Tank - Developer & Designer Portfolio" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Kosugi&display=swap" rel="stylesheet">
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<!-- Shader background canvas -->
		<ShaderBackground />

		<!-- Frame border container -->
		<div class="frame-border">
			<!-- Main wrapper uses flexbox to create full-height layout -->
			<div class="site-wrapper">
				<!-- Navigation component -->
				<nav class="main-nav">
					<!-- Header section with name and title -->
					<header class="nav-header">
						<h1 class="name">Sankalp Tank</h1>
						<p class="subtitle">Developer &<br/>Designer</p>
						<p class="location">NC, USA</p>
					</header>

					<!-- Navigation links -->
					<ul class="nav-links">
						<li><a href="/" class={Astro.url.pathname === "/" ? "active" : ""}>Home</a></li>
						<li><a href="/work" class={Astro.url.pathname === "/work" ? "active" : ""}>Work</a></li>
						<li><a href="/contact" class={Astro.url.pathname === "/contact" ? "active" : ""}>Contact</a></li>
					</ul>
				</nav>

				<!-- Main content area where page content is inserted -->
				<main class="main-content">
					<slot />
				</main>
			</div>
		</div>

		<!-- Dark mask for outside the frame - positioned after frame so it overlays the outer area -->
		<div class="outer-mask"></div>
	</body>
</html>

<style is:global>
	/* Global reset and base styles */
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
		transition: opacity 0.1s ease-in-out;
				font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;

	}

	body {
		font-family: 'Kosugi', sans-serif;
		background-color: #000;
		color: #fff;
		min-height: 100vh;
		height: 100vh;
		position: relative;
		padding: 1rem;
		overflow: hidden;
	}

	@media (min-width: 768px) {
		body {
			padding: 2rem;
		}
	}

	/* Frame border container */
	.frame-border {
		position: relative;
		height: calc(100vh - 2rem);
		border: 1px solid #fff;
		z-index: 1;
		overflow: hidden;
	}

	@media (min-width: 768px) {
		.frame-border {
			height: calc(100vh - 4rem);
		}
	}

	/* Dark mask for the area outside the frame border */
	.outer-mask {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
		z-index: 10;
		box-shadow: inset 0 0 0 1rem rgba(0, 0, 0, 0.5);
	}

	@media (min-width: 768px) {
		.outer-mask {
			box-shadow: inset 0 0 0 2rem rgba(0, 0, 0, 0.65);
		}
	}

	/* Main site wrapper using flexbox for layout */
	.site-wrapper {
		display: flex;
		flex-direction: column;
		height: 100%;
		position: relative;
		z-index: 1;
	}

	@media (min-width: 768px) {
		.site-wrapper {
			flex-direction: row;
		}
	}

	/* Navigation sidebar styles */
	.main-nav {
		/* Flexbox for vertical layout */
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		min-width: auto;
		padding: 1rem;
		border-bottom: 1px solid #fff;
	}

	@media (min-width: 768px) {
		.main-nav {
			gap: 4rem;
			min-width: 300px;
			padding-left: 2rem;
			padding-top: 2rem;
			border-bottom: none;
		}
	}

	/* Header section within nav */
	.nav-header {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.name {
		font-size: 1.75rem;
		font-weight: normal;
		line-height: 1.1;
	}

	.subtitle {
		font-size: 1rem;
		font-weight: normal;
		line-height: 1.3;
	}

	.location {
		font-size: 0.875rem;
		margin-top: 0.5rem;
	}

	@media (min-width: 768px) {
		.name {
			font-size: 2.5rem;
		}

		.subtitle {
			font-size: 1.25rem;
		}

		.location {
			font-size: 1rem;
			margin-top: 1rem;
		}
	}

	/* Navigation links list */
	.nav-links {
		list-style: none;
		display: flex;
		flex-direction: row;
		gap: 1rem;
	}

	.nav-links a {
		color: #fff;
		text-decoration: none;
		font-size: 1.125rem;
		position: relative;
		display: inline-block;
	}

	@media (min-width: 768px) {
		.nav-links {
			flex-direction: column;
			gap: 0.5rem;
		}

		.nav-links a {
			font-size: 1.5rem;
		}
	}

	.nav-links a:hover {
		opacity: 0.7;
	}

	/* Main content area */
	.main-content {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	/* Utility class for centering content */
	.centered-content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-end;
		height: 100%;
		gap: 2rem;
	}

	/* Section wrapper for work items */
	.work-section {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		justify-content: center;
		flex: 1;
	}

	/* Individual work item using flexbox */
	.work-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		align-items: flex-start;
	}

	.work-item h2 {
		font-size: 1.5rem;
		font-weight: normal;
	}

	.work-item p {
		font-size: 1.125rem;
		text-align: left;
	}

	@media (min-width: 768px) {
		.work-section {
			gap: 3rem;
		}

		.work-item {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}

		.work-item h2 {
			font-size: 2rem;
		}

		.work-item p {
			font-size: 1.5rem;
			text-align: right;
		}
	}

	/* Contact page specific styles */
	.contact-content {
		display: flex;
		flex-direction: column;
		height: 100%;
		gap: 2rem;
	}

	/* Left side with text content */
	.contact-text {
		flex: 1;
		display: flex;
		align-items: center;
	}

	.contact-text p {
		font-size: 1.25rem;
		line-height: 1.6;
		max-width: 600px;
	}

	/* Right side with social icons */
	.contact-social {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.social-icon {
		width: 60px;
		height: 60px;
		background-color: #fff;
		border-radius: 15px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.social-icon img {
		width: 35px;
		height: 35px;
	}

	@media (min-width: 768px) {
		.contact-content {
			flex-direction: row;
		}

		.contact-text p {
			font-size: 1.5rem;
		}

		.contact-social {
			align-items: flex-end;
			gap: 2rem;
		}

		.social-icon {
			width: 80px;
			height: 80px;
			border-radius: 20px;
		}

		.social-icon img {
			width: 50px;
			height: 50px;
		}
	}
</style>
