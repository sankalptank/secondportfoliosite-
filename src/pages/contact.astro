---
// Contact page component
// Displays introductory text on left and social media icons on the right
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Sankalp Tank">
	<!-- Contact page wrapper using flexbox for horizontal layout -->
	<div class="contact-wrapper">
		<!-- Left section: Introductory text using flexbox for centering -->

		<!-- Right section: Social media icons using flexbox -->
		<aside class="social-links">
			<!-- Instagram link with icon -->
			<a href="https://instagram.com/sankalptank" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
				<div class="icon-box">
					<img src="/icons/instagram.svg" alt="Instagram" />
				</div>
			</a>

			<!-- GitHub link with icon -->
			<a href="https://github.com/sankalptank" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<div class="icon-box">
					<img src="/icons/github.svg" alt="GitHub" />
				</div>
			</a>

			<!-- LinkedIn link with icon -->
			<a href="https://www.linkedin.com/in/sankalp-tank-572372347" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
				<div class="icon-box">
					<img src="/icons/linkedin.svg" alt="LinkedIn" />
				</div>
			</a>

			<!-- Email link with icon -->
			<a href="mailto:sankalptank@sankalptank.com" aria-label="Email">
				<div class="icon-box">
					<img src="/icons/email.svg" alt="Email" />
				</div>
			</a>
		</aside>
	</div>
</Layout>

<style>
	/* Contact wrapper using flexbox for horizontal layout */
	.contact-wrapper {
		display: flex;
		justify-content: center;
		align-items: center;
		height: 100%;
		flex: 1;
		gap: 2rem;
		padding: 1rem;
	}

	/* Intro text section using flexbox for vertical centering */
	.intro-text {
		flex: 1;
		display: flex;
		align-items: center;
	}

	/* Paragraph styling */
	.intro-text p {
		font-size: 1.25rem;
		line-height: 1.6;
		max-width: 600px;
	}

	/* Social links container using flexbox for horizontal layout */
	.social-links {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	/* Remove default link styling */
	.social-links a {
		text-decoration: none;
	}

	/* Icon box using flexbox for centering icon */
	.icon-box {
		width: 60px;
		height: 60px;
		border-radius: 15px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: opacity 0.1s ease-in-out;
	}

	/* Hover effect for icon boxes */
	.icon-box:hover {
		opacity: 0.7;
	}

	/* Icon image sizing */
	.icon-box img {
		width: 35px;
		height: 35px;
		filter: brightness(0) invert(1);
	}

	@media (min-width: 768px) {
		.contact-wrapper {
			justify-content: flex-end;
			align-items: flex-end;
			gap: 4rem;
			padding-right: 2rem;
			padding-bottom: 2rem;
		}

		.intro-text p {
			font-size: 1.5rem;
		}

		.social-links {
			gap: 2rem;
			flex-wrap: nowrap;
		}

		.icon-box {
			width: 80px;
			height: 80px;
			border-radius: 20px;
		}

		.icon-box img {
			width: 50px;
			height: 50px;
		}
	}
</style>
