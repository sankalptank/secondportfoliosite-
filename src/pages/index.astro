---
// Home page component
// Displays repeating "compelling headline" text on the right side
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sankalp Tank - Developer & Designer">
	<!-- Main content wrapper using flexbox to align content to the right -->
	<div class="home-content">
		<section class="intro-text">
			<p>
				Programming is a creative medium, but too often the opportunities it affords are not capitalized upon. I am pursuing a synthesis of efficiency and aesthetics.
		</section>
	</div>
</Layout>

<style>
	/* Home page content wrapper using flexbox */
	.home-content {
		display: flex;
		justify-content: center;
		align-items: center;
		flex: 1;
		padding: 1rem;
	}

	/* Intro text section styling */
	.intro-text {
		max-width: 100%;
		text-align: center;
	}

	.intro-text p {
		font-size: 1.125rem;
		line-height: 1.6;
		font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
	}

	/* Container for headlines using flexbox for vertical layout */
	.headlines {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	/* Individual headline styling */
	.headlines h2 {
		font-size: 1.75rem;
		font-weight: normal;
		line-height: 1.2;
		text-align: center;
	}

	@media (min-width: 768px) {
		.home-content {
			justify-content: flex-end;
			align-items: flex-end;
			padding-right: 2rem;
			padding-bottom: 2rem;
		}

		.intro-text {
			max-width: 45vw;
			text-align: right;
		}

		.intro-text p {
			font-size: 1.5rem;
		}

		.headlines {
			gap: 2rem;
		}

		.headlines h2 {
			font-size: 2.5rem;
			text-align: right;
		}
	}
</style>
