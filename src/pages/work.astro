---
// Work page - unified project list with category tags
import Layout from '../layouts/Layout.astro';
---

<Layout title="Work - Sankalp Tank">
	<div class="work-detail-page">
		<!-- Center preview area -->
		<div class="preview-container">
			<div class="preview-content">
				<h2 id="preview-title"></h2>
				<p id="preview-text"></p>
				<a id="preview-link" class="preview-link" href="" target="_blank" rel="noopener"></a>
				<img id="preview-image" src="" alt="" />
			</div>
		</div>

		<!-- Right side project list, most recent first -->
		<div class="scroll-container">
			<ul class="project-list">
				<li
					data-title="Think Tank AI"
					data-text="

Designed and developed the production website for Think Tank AI, a boutique ML/AI consulting firm. Built in Astro with vanilla CSS and JS, no component framework or utility library, deployed as a static site. Scope included information architecture, a Web3Forms-backed contact flow, and custom interactive components like a tabbed services module with synchronized content panels."
					data-image=""
					data-link="https://ttankai.com"
					data-link-label="Visit site ↗"
				>
					<div class="project-header">
						<h2>ttankai.com</h2>
						<span class="tag">webdev</span>
						<a class="list-link" href="https://ttankai.com" target="_blank" rel="noopener" aria-label="Visit ttankai.com">↗</a>
					</div>
					<p>Apr 2026</p>
				</li>
				<li
					data-title="How Can Disparate Retrieval Methods Work Together Effectively?"
					data-text="Engineered a hybrid funnel retrieval architecture for fast record lookup on large datasets. Benchmarked sparse methods (TF-IDF, BM25, and SUPER_BM25, a variant I developed) against dense methods (SPLADE, ColBERT), then combined them into a cascading system that cut indexing time by 23.7% and query time by 99% versus ColBERT alone, with comparable recall. Published in the American Journal of Student Research, Vol. 3, Issue 6 (Nov 2025)."
					data-image=""
					data-link="https://ajosr.org/papers/volume-3/issue-6/how-can-disparate-retrieval-methods-work-together-effectively/"
					data-link-label="Read paper ↗"
				>
					<div class="project-header">
						<h2>How Can Disparate Retrieval Methods Work Together Effectively?</h2>
						<span class="tag">data</span>
						<span class="tag">paper</span>
						<a class="list-link" href="https://ajosr.org/papers/volume-3/issue-6/how-can-disparate-retrieval-methods-work-together-effectively/" target="_blank" rel="noopener" aria-label="Read paper">↗</a>
					</div>
					<p>Sep 2025</p>
				</li>
				<li
					data-title="Brick & Motors"
					data-text="Designed and developed the production website for Bricks and Motors, a small educational business introducing kids to STEM. Built in Astro with vanilla CSS and JS, no component framework or utility library, deployed as a static site. Scope included information architecture and a Web3Forms-backed contact flow."
					data-image=""
					data-link="https://bricksandmotors.org"
					data-link-label="Visit site ↗"
				>
					<div class="project-header">
						<h2>bricksandmotors.org</h2>
						<span class="tag">webdev</span>
						<a class="list-link" href="https://bricksandmotors.org" target="_blank" rel="noopener" aria-label="Visit bricksandmotors.org">↗</a>
					</div>
					<p>Sep 2025</p>
				</li>
				<li
					data-title="Westcreek Public School"
					data-text="Built a book and author recommendation system for a school library of 5,466 books. Online recommenders kept suggesting titles the library didn't actually stock, so the system works only off the library's own catalog. Enriched the raw inventory with genre data from the Open Library API, with a GPT-4 fallback for the roughly one-third of books not indexed there. Recommendations are computed with cosine similarity across title, author, and genre features, alongside a parallel author-level recommender comparing aggregated genres per author. Shipped as both a web app and a standalone Windows executable for student use."
					data-image=""
					data-link="https://github.com/sankalptank/Durham-District-School-Board-Library-Recommendation-System"
					data-link-label="View repo ↗"
				>
					<div class="project-header">
						<h2>Westcreek Public School Library Recommendation System</h2>
						<span class="tag">data</span>
						<a class="list-link" href="https://github.com/sankalptank/Durham-District-School-Board-Library-Recommendation-System" target="_blank" rel="noopener" aria-label="View repository">↗</a>
					</div>
					<p>Nov 2024</p>
				</li>
				<li
					data-title="Dynamic Markdown Article System for Developer Portfolio"
					data-text="Helped a friend build out his developer portfolio site, focused on a markdown-driven blog system where dropping a .md file into a folder automatically adds it to the blog index. He used it to publish Lua and game dev tutorials. Also handled hosting, responsive behavior, and performance optimization. Design work was his.

"
					data-image=""
					data-link="https://defjunior.github.io/portfolio/"
					data-link-label="Visit site ↗"
				>
					<div class="project-header">
						<h2>defjunior.github.io/portfolio/</h2>
						<span class="tag">webdev</span>
						<a class="list-link" href="https://defjunior.github.io/portfolio/" target="_blank" rel="noopener" aria-label="Visit J1 Development Studio">↗</a>
					</div>
					<p>Oct 2024</p>
				</li>
			</ul>
		</div>
	</div>
</Layout>

<script>
	function initializeProjectPreviews() {
		const projectItems = document.querySelectorAll('.project-list li');
		const previewTitle = document.getElementById('preview-title');
		const previewText = document.getElementById('preview-text');
		const previewLink = document.getElementById('preview-link') as HTMLAnchorElement | null;
		const previewImage = document.getElementById('preview-image') as HTMLImageElement | null;
		let selectedProject: Element | null = null;

		function updatePreview(item: Element) {
			const el = item as HTMLElement;
			const title = el.dataset.title || '';
			const text = el.dataset.text || '';
			const image = el.dataset.image || '';
			const link = el.dataset.link || '';
			const linkLabel = el.dataset.linkLabel || '';

			if (previewTitle) previewTitle.textContent = title;
			if (previewText) previewText.textContent = text;

			if (previewLink) {
				if (link) {
					previewLink.href = link;
					previewLink.textContent = linkLabel || link;
					previewLink.style.display = 'inline-block';
				} else {
					previewLink.removeAttribute('href');
					previewLink.textContent = '';
					previewLink.style.display = 'none';
				}
			}

			if (previewImage) {
				if (image) {
					previewImage.src = image;
					previewImage.alt = title;
					previewImage.style.display = 'block';
				} else {
					previewImage.style.display = 'none';
				}
			}
		}

		function resetPreview() {
			if (previewTitle) previewTitle.textContent = '';
			if (previewText) previewText.textContent = '';
			if (previewLink) {
				previewLink.removeAttribute('href');
				previewLink.textContent = '';
				previewLink.style.display = 'none';
			}
			if (previewImage) previewImage.style.display = 'none';
		}

		projectItems.forEach(item => {
			item.addEventListener('mouseenter', () => {
				if (!selectedProject) {
					updatePreview(item);
				}
			});

			item.addEventListener('click', (e) => {
				// Let the shortcut arrow's click navigate normally — don't toggle preview.
				if ((e.target as HTMLElement).closest('.list-link')) return;

				if (selectedProject === item) {
					selectedProject = null;
					item.classList.remove('selected');
				} else {
					if (selectedProject) {
						selectedProject.classList.remove('selected');
					}
					selectedProject = item;
					item.classList.add('selected');
					updatePreview(item);
				}
			});
		});

		const scrollContainer = document.querySelector('.scroll-container');
		scrollContainer?.addEventListener('mouseleave', () => {
			if (!selectedProject) {
				resetPreview();
			}
		});
	}

	function initializePageScroll() {
		const scrollContainer = document.querySelector('.scroll-container');
		if (!scrollContainer) return;

		document.addEventListener('wheel', (e) => {
			scrollContainer.scrollTop += e.deltaY * 4;
			e.preventDefault();
		}, { passive: false });
	}

	initializeProjectPreviews();
	initializePageScroll();

	document.addEventListener('astro:page-load', () => {
		initializeProjectPreviews();
		initializePageScroll();
	});
</script>

<style>
	.work-detail-page {
		display: flex;
		flex-direction: column;
		height: 100%;
		gap: 1rem;
	}

	/* Detail preview area */
	.preview-container {
		flex: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		min-height: 200px;
	}

	.preview-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 1rem;
		max-width: 100%;
		text-align: left;
	}

	#preview-title {
		font-size: 1.5rem;
		font-weight: normal;
		margin: 0;
	}

	#preview-text {
		font-size: 1rem;
		line-height: 1.6;
		opacity: 0.9;
		margin: 0;
	}

	.preview-link {
		color: #fff;
		text-decoration: none;
		font-size: 0.9rem;
		opacity: 0.7;
		display: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.3);
		padding-bottom: 1px;
		transition: opacity 0.2s ease;
	}

	.preview-link:hover {
		opacity: 1;
	}

	#preview-image {
		max-width: 100%;
		max-height: 250px;
		border-radius: 8px;
		display: none;
		object-fit: contain;
	}

	/* Right side project list */
	.scroll-container {
		width: 100%;
		min-width: auto;
		max-height: 50vh;
		overflow-y: scroll;
		scroll-behavior: smooth;
		scrollbar-width: none;
		scrollbar-color: #fff transparent;
		padding: 0 1rem;
	}

	.scroll-container::-webkit-scrollbar {
		width: 8px;
	}

	.scroll-container::-webkit-scrollbar-track {
		background: transparent;
	}

	.scroll-container::-webkit-scrollbar-thumb {
		background-color: #fff;
		border-radius: 4px;
	}

	.project-list {
		padding-top: 0rem;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-left: 0;
		padding-right: 0;
		padding-bottom: 13rem;
		margin: 0;
	}

	.project-list li {
		cursor: pointer;
		transition: all 0.5s ease;
		padding: 0.75rem;
		border-radius: 4px;
		background-color: rgba(0, 0, 0, 0.3);
		min-height: 5rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.project-list li:hover {
		opacity: 0.7;
		background-color: rgba(255, 255, 255, 0.05);
	}

	.project-list li.selected {
		background-color: rgba(255, 255, 255, 0.1);
		opacity: 1;
	}

	.project-header {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 0.25rem;
	}

	.project-header h2 {
		flex: 1;
		font-size: 1.25rem;
		margin: 0;
		font-weight: normal;
	}

	.tag {
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding: 0.15rem 0.4rem;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 2px;
		opacity: 0.6;
	}

	.list-link {
		color: #fff;
		text-decoration: none;
		font-size: 0.95rem;
		opacity: 0.5;
		padding: 0 0.25rem;
		transition: opacity 0.2s ease;
	}

	.list-link:hover {
		opacity: 1;
	}

	.project-list li p {
		font-size: 0.875rem;
		opacity: 0.7;
		margin: 0;
	}

	@media (min-width: 768px) {
		.work-detail-page {
			flex-direction: row;
			gap: 2rem;
		}

		.preview-container {
			padding: 2rem 3rem;
			min-height: auto;
		}

		.preview-content {
			gap: 1.5rem;
			max-width: 500px;
		}

		#preview-title {
			font-size: 2.5rem;
		}

		#preview-text {
			font-size: 1.25rem;
		}

		.preview-link {
			font-size: 1.05rem;
		}

		#preview-image {
			max-height: 400px;
		}

		.scroll-container {
			width: auto;
			min-width: 280px;
			max-width: 350px;
			max-height: 100vh;
			padding: 0 1rem 0 0;
		}

		.project-list {
			gap: 2rem;
			padding-top: 13rem;
		}

		.project-list li {
			padding: 1rem;
		}

		.project-header h2 {
			font-size: 1.75rem;
			margin: 0;
		}

		.tag {
			font-size: 0.7rem;
		}

		.list-link {
			font-size: 1.1rem;
		}

		.project-list li p {
			font-size: 1rem;
		}
	}
</style>
